{
  "name": "guys-n-heat",
  "version": "1.0.0",
  "private": true,
  "repository": "https://github.com/brotherhood-group/guys-n-heat.git",
  "author": "Jason <jason@guysnheat.com>",
  "license": "MIT",
  "workspaces": [
    "packages/automation",
    "packages/app",
    "packages/admin"
  ],
  "scripts": {
    "admin": "yarn workspace admin ",
    "app": "yarn workspace app ",
    "automation": "yarn workspace automation ",
    "gcp": "yarn workspace gcp ",
    "email": "yarn workspace email ",
    "start": "docker-compose up -d",
    "stop": "docker-compose down",
    "preclean": "rm -rf yarn.lock",
    "clean": "rm -rf node_modules && yarn app clean && yarn",
    "postclean": "cp yarn.lock ./packages/app/",
    "postinstall": "chmod +x .devcontainer/.bashrc && bash -c 'source .devcontainer/.bashrc'",
    "admin:secrets": "kubectl create secret generic gnh-admin --from-env-file=packages/admin/.env.production -n gnh",
    "app:secrets": "kubectl create secret generic gnh-app --from-env-file=packages/app/.env.production -n gnh",
    "prettier-format": "prettier --config .prettierrc 'packages/app/**/*.tsx' --write"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.1.0",
    "typescript": "^5.2.2"
  }
}
