{
  "name": "guys-n-heat",
  "version": "1.0.0",
  "private": true,
  "repository": "https://github.com/brotherhood-group/guys-n-heat.git",
  "author": "Jason Wicker <jason@thebrotherhoodgroup.org>",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "admin": "yarn workspace admin ",
    "app": "yarn workspace app ",
    "start": "docker-compose up -d",
    "stop": "docker-compose down",
    "postinstall": "chmod +x .devcontainer/.bashrc && bash -c 'source .devcontainer/.bashrc'",
    "types": "ts-node-esm .build/generate-types.ts"
  },
  "prettier": {
    "arrowParens": "always",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "none"
  },
  "devDependencies": {
    "change-case": "^4.1.2",
    "oao": "^2.0.2",
    "openapi-typescript": "^5.4.1",
    "ts-node": "^10.9.1"
  },
  "dependencies": {
    "next": "^12.3.1"
  }
}