{
  "name": "guys-n-heat",
  "version": "1.0.0",
  "private": true,
  "repository": "https://github.com/brotherhood-group/guys-n-heat.git",
  "author": "Jason Wicker <jason@thebrotherhoodgroup.org>",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "admin": "yarn workspace admin ",
    "app": "yarn workspace app ",
    "gcp": "yarn workspace gcp ",
    "start": "docker-compose up -d",
    "stop": "docker-compose down",
    "postinstall": "chmod +x .devcontainer/.bashrc && bash -c 'source .devcontainer/.bashrc'"
  },
  "prettier": {
    "arrowParens": "always",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "none"
  }
}