{
	"name": "Node.js & TypeScript",
	"build": {
		"dockerfile": "Dockerfile",
		"args": {
			"VARIANT": "16-bullseye"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"dbaeumer.vscode-eslint",
				"googlecloudtools.cloudcode"
			]
		}
	},
	"remoteEnv": {
		"COMPOSE_DOCKER_CLI_BUILD": "1",
		"DOCKER_BUILDKIT": "1",
		"GOOGLE_APPLICATION_CREDENTIALS": "/workspaces/guys-n-heat/.private/gnh-application-key.json",
		"GCP_PROJECT": "tbh-gnh"
	},
	"postCreateCommand": "yarn install",
	"postAttachCommand": "chmod +x .devcontainer/.bashrc && .devcontainer.bashrc",
	"remoteUser": "node",
	"features": {
		"docker-from-docker": "latest",
		"git": "os-provided",
		"github-cli": "latest",
		"sshd": "latest"
	}
}