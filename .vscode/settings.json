  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "typescript.tsdk": "./node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnPaste": true, // required
  "editor.formatOnType": true, // required
  "editor.formatOnSaveMode": "file", // required to format on save
  "files.autoSave": "onFocusChange", // optional but recommended]
  "editor.suggest.filterGraceful": true,
  "editor.suggest.localityBonus": true,
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "autoimport.absolute": true,
  "autoimport.filesToScan": "packages/app/**/*.{ts,tsx}",
  "autoimport.higherOrderComponents": "connect|withRouter|useEffect|",
  "autoimport.semicolon": false,
  "autoimport.showNotifications": true,
  "autoimport.sourceRoot": "packages/app/",
  "cloudcode.kubeconfigs": [
    {
      "name": "/home/jason/.kube/config",
      "configPath": "/home/jason/.kube/config"
    }
  ],
  "cloudcode.active-kubeconfig": "/home/jason/.kube/config",
}