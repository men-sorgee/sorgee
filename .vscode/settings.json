  "editor.formatOnSave": true,
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "cSpell.words": [
    "authentification",
    "basemaps",
    "Consolas",
    "daisyui",
    "datetime",
    "ethnicities",
    "EXIF",
    "filesize",
    "flowbit",
    "flowbite",
    "guysnheat",
    "headlessui",
    "heroicons",
    "hookform",
    "KHTML",
    "mapbox",
    "nextjs",
    "openapi",
    "Parens",
    "Polyamorous",
    "rlig",
    "Roboto",
    "sendgrid",
    "supabase",
    "twind",
    "uuidv"
  ],
  "editor.suggest.showStatusBar": true,
  "editor.quickSuggestions": {
    "strings": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}