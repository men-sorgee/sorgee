    "wellenplan"
  ],
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "typescript.tsdk": "./node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.importModuleSpecifier": "relative",
  "editor.defaultFormatter": "rvest.vs-code-prettier-eslint",
  "editor.formatOnPaste": false, // required
  "editor.formatOnType": false, // required
  "editor.formatOnSave": true, // optional
  "editor.formatOnSaveMode": "file", // required to format on save
  "files.autoSave": "onFocusChange", // optional but recommended
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker"
  },
  "[markdown]": {
    "editor.defaultFormatter": "rvest.vs-code-prettier-eslint"
  },
  "autoimport.filesToScan": "packages/app/**/*.{ts,tsx}",
  "autoimport.showNotifications": true,
  "cloudcode.kubeconfigs": [
    {
      "name": "/home/jason/.kube/config",
      "configPath": "/home/jason/.kube/config"
    }
  ],
  "cloudcode.active-kubeconfig": "/home/jason/.kube/config",
  "vitest.enable": true,
  "vitest.include": ["**/*.{test,spec}.{ts,tsx}"],
  "testing.automaticallyOpenPeekView": "never",
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "rvest.vs-code-prettier-eslint"
  },
  "eslint.codeActionsOnSave.mode": "problems",
  "vs-code-prettier-eslint.prettierLast": true
}
