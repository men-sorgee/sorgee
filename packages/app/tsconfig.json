{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "incremental": true,
    "jsx": "preserve",
    "jsxImportSource": "react",
    "plugins": [
      {
        "name": "@twind/typescript-plugin"
      }
    ],
    "paths": {
      "@/components/*": [
        "components/*"
      ],
      "@/lib/*": [
        "lib/*"
      ],
      "@/models": [
        "lib/models/*"
      ],
      "@/config": [
        "lib/config/*"
      ],
      "@/styles": [
        "styles/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "next.config.ts",
    "tailwind.config.js",
    "middleware.ts"
  ],
  "exclude": [
    "node_modules",
    ".idea"
  ]
}
