    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@heroicons/react": "v1",
    "@hookform/error-message": "^2.0.1",
    "@next/font": "^13.1.1",
    "@sendgrid/mail": "^7.7.0",
    "chakra-ui-steps": "^1.8.0",
    "change-case": "^4.1.2",
    "dotenv": "^16.0.1",
    "editorjs-blocks-react-renderer": "^1.3.0",
    "eslint-config-next": "^13.1.1",
    "formidable": "^2.0.1",
    "framer-motion": "^8.2.4",
    "moment": "^2.29.4",
