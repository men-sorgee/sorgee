{
  "name": "app",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next && rm -rf node_modules",
    "dev": "next ",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "fix": "next lint --fix",
    "predocker:build": "cp ../../yarn.lock . && yarn install --frozen-lockfile",
    "docker:build": "docker build -t gcr.io/tbg-gnh/gnh-app .",
    "docker:push": "docker push gcr.io/tbg-gnh/gnh-app",
    "docker:run": "docker run --name gnh -p 3000:3000  gcr.io/tbg-gnh/gnh-app",
    "deploy": "gcloud run services replace service.yaml",
    "kill": "npx -y kill-port 3000",
    "test": "vitest --config ./vitest.config.ts",
    "coverage": "vitest run --coverage --config ./vitest.config.ts --outDir results",
    "test:view": "vite preview --outDir results",
    "gen": "bash types.sh"
  },
  "dependencies": {
